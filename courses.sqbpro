CREATE TABLE IF NOT EXISTS grade_points (
    grade   TEXT PRIMARY KEY,
    points  REAL,      -- NULL = not counted (audit/incomplete/withdrawn)
    is_pass INTEGER     -- 1 = pass, 0 = fail, NULL = not applicable
);

INSERT INTO grade_points (grade, points, is_pass) VALUES
('AP', 10, 1), ('AA', 10, 1), ('AB', 9, 1), ('BB', 8, 1),
('BC', 7, 1), ('CC', 6, 1), ('CD', 5, 1), ('DD', 4, 1),
('FF', 0, 0), ('FR', 0, 0), ('DX', 0, 0),
('II', NULL, NULL), ('AU', NULL, NULL), ('W', NULL, NULL), ('DR', NULL, NULL),
('PP', NULL, 1), ('NP', NULL, 0);</sql><current_tab id="0"/></tab_sql></sqlb_project>
